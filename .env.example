# SUPABASE_URL / SUPABASE_ANON_KEY: the Supabase project used for groups and announcements.
# These are placeholders so the project still builds without a .env file (the groups feature
# will not connect). To use your own project, copy this file to ".env" (it is git-ignored) and
# put the real values there. Never put real values in this file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
