<?xml version="1.0" encoding="utf-8"?>
<!-- Custom layout for the running stopwatch/countdown notification:
     time + label | pause/resume and stop icon buttons. The blue clock icon was removed so the
     "Stopwatch \u2022 Paused" label has room to show in full. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <Chronometer
            android:id="@+id/timer_notif_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/timer_notif_paused_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="22sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/timer_notif_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/timer_notif_primary"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_timer_notif_button"
        android:contentDescription="@string/timer_notif_pause"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_timer_pause" />

    <ImageButton
        android:id="@+id/timer_notif_stop"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_timer_notif_button"
        android:contentDescription="@string/timer_notif_stop"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_timer_stop" />
</LinearLayout>
