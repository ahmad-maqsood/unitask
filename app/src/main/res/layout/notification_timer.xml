<?xml version="1.0" encoding="utf-8"?>
<!-- Custom layout for the running stopwatch/countdown notification:
     icon | time + label | two round buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/timer_notif_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_timer_notif_clock" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <Chronometer
            android:id="@+id/timer_notif_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/timer_notif_paused_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="22sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/timer_notif_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/timer_notif_btn_primary"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_timer_notif_button"
        android:padding="10dp"
        android:src="@drawable/ic_timer_pause" />

    <ImageButton
        android:id="@+id/timer_notif_btn_stop"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_timer_notif_button"
        android:contentDescription="Stop"
        android:padding="10dp"
        android:src="@drawable/ic_timer_stop" />
</LinearLayout>
