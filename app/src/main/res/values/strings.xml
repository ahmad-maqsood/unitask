    <string name="onboarding_look_around">I\'ll look around first</string>
    <string name="onboarding_welcome_title">Welcome to UniTask</string>
    <string name="onboarding_welcome_body">Your classes, deadlines and group work in one place, with reminders that arrive on time.</string>
    <string name="onboarding_feature_deadline_title">Never miss a deadline</string>
    <string name="onboarding_feature_deadline_body">Add courses and deadlines, then get reminded before they are due.</string>
    <string name="onboarding_feature_week_title">Plan your week</string>
    <string name="onboarding_feature_week_body">Keep your class timetable and a focus timer in one app.</string>
    <string name="onboarding_feature_groups_title">Work in groups</string>
    <string name="onboarding_feature_groups_body">Share tasks with classmates using a join code.</string>
    <string name="onboarding_setup_title">Keep reminders on time</string>
    <string name="onboarding_setup_body">Some phones quiet or stop apps in the background, so reminders can arrive late or not at all. These settings prevent that. You can change them any time in your phone\'s settings.</string>
    <string name="onboarding_notifications_title">Notifications</string>
    <string name="onboarding_notifications_body">So reminders and group alerts can reach you.</string>
    <string name="onboarding_allow">Allow</string>
    <string name="onboarding_battery_title">Battery optimization</string>
    <string name="onboarding_battery_body">Stops your phone from putting UniTask to sleep, so reminders ring on time.</string>
    <string name="onboarding_autostart_title">Auto-start</string>
    <string name="onboarding_autostart_body">Keeps reminders working after your phone restarts.</string>
    <string name="onboarding_open_settings">Open settings</string>
    <string name="onboarding_steps_title">Your first steps</string>
    <string name="onboarding_steps_body">Three quick things and UniTask is working for you. It takes about a minute.</string>
    <string name="onboarding_step_course_title">Add a course</string>
    <string name="onboarding_step_course_body">Something like \"Calculus\" or \"CS101\". Deadlines and classes belong to a course.</string>
    <string name="onboarding_step_deadline_title">Add a deadline</string>
    <string name="onboarding_step_deadline_body">An assignment, a quiz or an exam, with the date it is due.</string>
    <string name="onboarding_step_reminder_title">Set a reminder</string>
    <string name="onboarding_step_reminder_body">Use the Remind me row on a deadline so it rings before it is due.</string>
    <string name="onboarding_steps_card_note">A Get started card at the top of Deadlines keeps track of these and a few more (timetable, timer, backup), and ticks them for you as you go.</string>
    <string name="onboarding_turned_on">Turned on</string>
