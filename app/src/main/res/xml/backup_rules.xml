<?xml version="1.0" encoding="utf-8"?>
<!--
   UniTask keeps its own backups (Google Drive and a backup file), so Android's automatic
   backup is switched off in AndroidManifest.xml (allowBackup="false"). These rules say the
   same thing again, so nothing is copied even if allowBackup is ever changed by mistake.
   Applies to Android 11 and older. Newer phones use data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
