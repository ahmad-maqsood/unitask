rules_version = '2';
 
service cloud.firestore {
  match /databases/{database}/documents {
 
    function isAuthenticated() {
      return request.auth != null;
    }
 
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
 
    function isValidCourse(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.code is string &&
             data.code.size() > 0 &&
             data.code.size() <= 30 &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 100 &&
             (!('instructor' in data) || data.instructor is string) &&
             (!('colorHex' in data) || data.colorHex is string) &&
             (!('location' in data) || data.location is string) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }
 
    function isValidTask(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() > 0 &&
             data.title.size() <= 200 &&
             data.dueDateEpochMillis is number &&
             data.priority in ['LOW', 'MEDIUM', 'HIGH'] &&
             data.status in ['PENDING', 'COMPLETED'] &&
             (!('description' in data) || data.description is string) &&
             (!('courseCode' in data) || data.courseCode is string) &&
             (!('dueTimeHour' in data) || (data.dueTimeHour is number && data.dueTimeHour >= 0 && data.dueTimeHour <= 23)) &&
             (!('dueTimeMinute' in data) || (data.dueTimeMinute is number && data.dueTimeMinute >= 0 && data.dueTimeMinute <= 59)) &&
             (!('reminderOption' in data) || data.reminderOption is string) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }
 
    function isValidSlot(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.courseCode is string &&
             data.courseCode.size() > 0 &&
             data.courseCode.size() <= 30 &&
             data.dayOfWeek is number &&
             data.dayOfWeek >= 1 &&
             data.dayOfWeek <= 7 &&
             data.startHour is number &&
             data.startHour >= 0 &&
             data.startHour <= 23 &&
             data.startMinute is number &&
             data.startMinute >= 0 &&
             data.startMinute <= 59 &&
             data.endHour is number &&
             data.endHour >= 0 &&
             data.endHour <= 23 &&
             data.endMinute is number &&
             data.endMinute >= 0 &&
             data.endMinute <= 59 &&
             (!('classroom' in data) || data.classroom is string) &&
             (!('instructor' in data) || data.instructor is string) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }
 
    match /users/{userId} {
      allow read, write: if isOwner(userId);
 
      match /courses/{courseId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCourse(request.resource.data);
        allow delete: if isOwner(userId);
      }
 
      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTask(request.resource.data);
        allow delete: if isOwner(userId);
      }
 
      match /slots/{slotId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSlot(request.resource.data);
        allow delete: if isOwner(userId);
      }
 
      // Which groups this user belongs to (a private bookmark list).
      match /groupMemberships/{groupId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['groupId', 'username', 'name', 'role', 'joinedAt'])
          && request.resource.data.groupId == groupId
          && request.resource.data.username is string
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60
          && request.resource.data.role in ['owner', 'member', 'admin'];
      }
 
      // This user's own "done" marks for group tasks. Never visible to other members.
      match /groupDone/{doneId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['groupId', 'taskId', 'doneAt'])
          && request.resource.data.groupId is string
          && request.resource.data.taskId is string;
      }
    }
 
    // ------------------------------------------------------------------
    // Groups: shared task lists. Top-level collections, separate from users/.
    // ------------------------------------------------------------------
 
    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }
 
    function isGroupMember(groupId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
 
    function isGroupOwner(groupId) {
      return isAuthenticated()
        && exists(groupPath(groupId))
        && get(groupPath(groupId)).data.ownerId == request.auth.uid;
    }

    function isGroupAdmin(groupId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    function isGroupStaff(groupId) {
      return isGroupOwner(groupId) || isGroupAdmin(groupId);
    }
 
    function isValidUsername(name) {
      return name is string && name.matches('^[a-z0-9_]{3,20}$');
    }
 
    function isValidGroupTask(data) {
      return data.keys().hasOnly(['title', 'description', 'courseLabel', 'dueDateEpochMillis',
                                  'dueTimeHour', 'dueTimeMinute', 'priority',
                                  'createdBy', 'createdByName', 'createdAt', 'updatedAt', 'reminderOptions', 'assignedTo'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.dueDateEpochMillis is number
        && data.dueTimeHour is number && data.dueTimeHour >= 0 && data.dueTimeHour <= 23
        && data.dueTimeMinute is number && data.dueTimeMinute >= 0 && data.dueTimeMinute <= 59
        && data.priority in ['LOW', 'MEDIUM', 'HIGH']
        && data.createdBy is string
        && data.createdByName is string && data.createdByName.size() <= 60
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('courseLabel' in data) || (data.courseLabel is string && data.courseLabel.size() <= 60))
        && (!('reminderOptions' in data) || (data.reminderOptions is string && data.reminderOptions.size() <= 100))
        && (!('assignedTo' in data) || (data.assignedTo is list && data.assignedTo.size() > 0 && data.assignedTo.size() <= 200))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }
 
    // One small record per group username. Creating it only succeeds if no record with that
    // id exists yet, which is what makes usernames unique even when two people race.
    match /groupNames/{name} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated()
        && isValidUsername(name)
        && request.resource.data.keys().hasOnly(['groupId', 'ownerId', 'createdAt'])
        && request.resource.data.groupId is string
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(groupPath(request.resource.data.groupId)).data.username == name
        && getAfter(groupPath(request.resource.data.groupId)).data.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }
 
    match /groups/{groupId} {
      allow get: if isGroupMember(groupId);
      allow list: if false;
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['username', 'name', 'ownerId', 'joinCode', 'createdAt'])
        && isValidUsername(request.resource.data.username)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.joinCode is string
        && request.resource.data.joinCode.size() >= 8 && request.resource.data.joinCode.size() <= 16
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/groupNames/$(request.resource.data.username)).data.groupId == groupId
        && getAfter(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'owner';
      allow update: if false;
      allow delete: if isGroupOwner(groupId);
 
      match /members/{uid} {
        allow get: if isAuthenticated() && (request.auth.uid == uid || isGroupMember(groupId));
        allow list: if isGroupMember(groupId);
        allow create: if isAuthenticated()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'role', 'joinCode', 'joinedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 60
          && request.resource.data.joinedAt == request.time
          && (
            // The creator becomes the owner in the same batch that creates the group.
            (request.resource.data.role == 'owner'
              && !exists(groupPath(groupId))
              && getAfter(groupPath(groupId)).data.ownerId == uid)
            ||
            // Anyone else joins an existing group by presenting its join code.
            (request.resource.data.role == 'member'
              && exists(groupPath(groupId))
              && request.resource.data.joinCode is string
              && request.resource.data.joinCode == get(groupPath(groupId)).data.joinCode)
          );
        allow update: if isGroupOwner(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['admin', 'member'];
        // A member or admin can leave. The owner can remove others. Admins can remove plain members.
        // The owner's own record can only go in the same batch that deletes the group.
        allow delete: if isAuthenticated() && (
          (request.auth.uid == uid && resource.data.role in ['member', 'admin'])
          || (isGroupOwner(groupId) && (uid != request.auth.uid || !existsAfter(groupPath(groupId))))
          || (isGroupAdmin(groupId) && resource.data.role == 'member')
        );
      }
 
      match /tasks/{taskId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && isValidGroupTask(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isGroupMember(groupId)
          && (resource.data.createdBy == request.auth.uid || isGroupStaff(groupId))
          && isValidGroupTask(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdByName == resource.data.createdByName
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if isGroupMember(groupId)
          && (resource.data.createdBy == request.auth.uid || isGroupStaff(groupId));
      }

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.keys().hasOnly(['text', 'senderId', 'senderName', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 60
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isGroupMember(groupId)
          && (resource.data.senderId == request.auth.uid || isGroupStaff(groupId));
      }
    }
 
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
